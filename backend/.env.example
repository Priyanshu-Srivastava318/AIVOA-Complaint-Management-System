# Copy this file to .env and fill in real values. Never commit .env.

# Get a key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Fast extraction/classification model.
# NOTE: the assignment names "gemma2-9b-it" specifically, but Groq deprecated that
# model on 2025-08-08 in favor of llama-3.1-8b-instant (their official recommended
# replacement, same speed/price tier). Using gemma2-9b-it here will fail with a
# model_decommissioned error, so llama-3.1-8b-instant is used instead.
GROQ_MODEL_FAST=llama-3.1-8b-instant

# Stronger model used for risk-classification / root-cause / CAPA / chat nodes.
# Heads up: Groq announced (2026-06-17) that this model is also being deprecated,
# with decommissioning expected around August 2026. If it stops working, switch to
# openai/gpt-oss-120b (Groq's recommended replacement) -- just update this one value.
GROQ_MODEL_REASONING=llama-3.3-70b-versatile

# Postgres connection string.
# If using Neon (as in this example), you MUST append ?sslmode=require or the
# connection will fail -- Neon requires SSL and psycopg2 does not default to it.
# Format: postgresql+psycopg2://<user>:<password>@<host>/<db>?sslmode=require
DATABASE_URL=postgresql+psycopg2://user:password@host/dbname?sslmode=require

# Comma separated list of origins allowed to call the API
CORS_ORIGINS=http://localhost:5173
